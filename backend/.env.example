# Get your connection string from the Neon Console:
# Project -> Dashboard -> Connect
DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require&channel_binding=require"

# Server (optional) - defaults to 8000 / 0.0.0.0.
# In production, leave PORT unset; the host (Render, Railway, Fly.io) injects it.
PORT=8000
HOST=0.0.0.0

# Arcjet - get your key from https://app.arcjet.com
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxxxxxx
# LIVE blocks requests; DRY_RUN only logs decisions. Defaults to LIVE.
ARCJET_MODE=LIVE
# Read by the Arcjet SDK: "development" allows localhost/private IPs.
# Remove this line in production.
ARCJET_ENV=development
